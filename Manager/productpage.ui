   </rect>
  </property>
  <property name="windowTitle">
   <string>商品管理</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* 主容器样式 */
QWidget#ProductPage {
    background: transparent;
    font-family: &quot;微软雅黑&quot;;
}

/* 标题区域 */
QWidget#headerWidget {
    background: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,
                stop:0 rgba(161, 140, 209, 0.1),
                stop:1 rgba(184, 164, 230, 0.1));
    border-radius: 15px;
    border: 1px solid rgba(161, 140, 209, 0.3);
}

QLabel#titleLabel {
    color: #6c5b7b;
    font: 700 16pt &quot;微软雅黑&quot;;
    background: transparent;
    border: none;
}

QLabel#subtitleLabel {
    color: #8b78c4;
    font: 11pt &quot;微软雅黑&quot;;
    background: transparent;
    border: none;
}

/* 统计卡片 */
QWidget#statsWidget {
    background: rgba(255, 255, 255, 0.8);
    border-radius: 12px;
    border: 1px solid rgba(214, 201, 247, 0.6);
}

QLabel#statsLabel {
    color: #6c5b7b;
    font: 600 10pt &quot;微软雅黑&quot;;
    background: transparent;
}

QLabel#countLabel {
    color: #a18cd1;
    font: 700 14pt &quot;微软雅黑&quot;;
    background: transparent;
}

/* 搜索区域 */
QWidget#searchWidget {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 12px;
    border: 1px solid rgba(214, 201, 247, 0.6);
}

QLineEdit#searchInput {
    background: rgba(255, 255, 255, 0.8);
    border: 2px solid rgba(214, 201, 247, 0.5);
    border-radius: 10px;
    padding: 12px 15px;
    font: 11pt &quot;微软雅黑&quot;;
    color: #5a4c74;
}

QLineEdit#searchInput:focus {
    border: 2px solid #a18cd1;
    background: white;
}

QLineEdit#searchInput:hover {
    border: 2px solid rgba(161, 140, 209, 0.7);
}

/* 主要按钮样式 - 紫色主题 */
QPushButton#addButton, QPushButton#searchButton {
    background: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,
                stop:0 #b8a4e6, stop:1 #a18cd1);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 12px 20px;
    font: 600 11pt &quot;微软雅黑&quot;;
    min-width: 100px;
}

QPushButton#addButton:hover, QPushButton#searchButton:hover {
    background: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,
                stop:0 #a18cd1, stop:1 #9179c4);
}

QPushButton#addButton:pressed, QPushButton#searchButton:pressed {
    background: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,
                stop:0 #9179c4, stop:1 #8066b7);
}

/* 次要按钮样式 - 浅紫色 */
QPushButton#refreshButton {
    background: rgba(184, 164, 230, 0.3);
    border: 2px solid rgba(161, 140, 209, 0.5);
    border-radius: 10px;
    padding: 10px 15px;
    font: 600 11pt &quot;微软雅黑&quot;;
    color: #7a6599;
}

QPushButton#refreshButton:hover {
    background: rgba(184, 164, 230, 0.5);
    border: 2px solid #a18cd1;
}

QPushButton#refreshButton:pressed {
    background: rgba(184, 164, 230, 0.7);
}

/* 表格样式 */
QWidget#tableWidget {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 12px;
    border: 1px solid rgba(214, 201, 247, 0.6);
}

QTableView {
    background: transparent;
    border: none;
    border-radius: 8px;
    gridline-color: rgba(214, 201, 247, 0.4);
    font: 10pt &quot;微软雅黑&quot;;
    color: #5a4c74;
    selection-background-color: rgba(161, 140, 209, 0.2);
}

QTableView::item {
    padding: 8px;
    border-bottom: 1px solid rgba(214, 201, 247, 0.3);
}

QTableView::item:selected {
    background: rgba(161, 140, 209, 0.2);
    color: #5a4c74;
}

QTableView::item:hover {
    background: rgba(214, 201, 247, 0.2);
}

QHeaderView::section {
    background: qlineargradient(spread:pad,x1:0,y1:0,x2:0,y2:1,
                stop:0 rgba(184, 164, 230, 0.8),
                stop:1 rgba(161, 140, 209, 0.8));
    color: white;
    padding: 10px 8px;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.3);
    font: 600 10pt &quot;微软雅黑&quot;;
}

QHeaderView::section:first {
    border-top-left-radius: 8px;
}

QHeaderView::section:last {
    border-top-right-radius: 8px;
    border-right: none;
}

/* 滚动条样式 */
QScrollBar:vertical {
    background: rgba(214, 201, 247, 0.3);
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(161, 140, 209, 0.6);
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #a18cd1;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background: rgba(214, 201, 247, 0.3);
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(161, 140, 209, 0.6);
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #a18cd1;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

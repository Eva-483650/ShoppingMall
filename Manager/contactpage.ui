  <property name="styleSheet">
   <string notr="true">
/* 主容器样式 */
QWidget#ContactPage {
    background: transparent;
    font-family: &quot;微软雅黑&quot;;
}

/* 标题区域 */
QWidget#headerWidget {
    background: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,
                stop:0 rgba(161, 140, 209, 0.1),
                stop:1 rgba(184, 164, 230, 0.1));
    border-radius: 15px;
    border: 1px solid rgba(161, 140, 209, 0.3);
}

QLabel#titleLabel {
    color: #6c5b7b;
    font: 700 20pt &quot;微软雅黑&quot;;
    background: transparent;
    border: none;
}

QLabel#subtitleLabel {
    color: #8b78c4;
    font: 12pt &quot;微软雅黑&quot;;
    background: transparent;
    border: none;
}

/* 消息显示区域 */
QWidget#messageArea {
    background: rgba(255, 255, 255, 0.8);
    border-radius: 12px;
    border: 1px solid rgba(214, 201, 247, 0.8);
}

QTextEdit#messageDisplay {
    background: transparent;
    border: none;
    font: 11pt &quot;微软雅黑&quot;;
    color: #5a4c74;
    selection-background-color: #e8e6fb;
}

QTextEdit#messageDisplay:focus {
    border: none;
    outline: none;
}

/* 输入区域 */
QWidget#inputArea {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 15px;
    border: 2px solid rgba(214, 201, 247, 0.6);
}

QWidget#inputArea:focus-within {
    border: 2px solid #a18cd1;
}

QTextEdit#messageInput {
    background: transparent;
    border: none;
    font: 11pt &quot;微软雅黑&quot;;
    color: #5a4c74;
    padding: 10px;
}

QTextEdit#messageInput:focus {
    border: none;
    outline: none;
}

/* 工具栏按钮 */
QPushButton#toolButton {
    background: rgba(194, 182, 243, 0.3);
    border: 1px solid rgba(161, 140, 209, 0.5);
    border-radius: 8px;
    padding: 8px 12px;
    font: 10pt &quot;微软雅黑&quot;;
    color: #7a6599;
    min-width: 60px;
}

QPushButton#toolButton:hover {
    background: rgba(194, 182, 243, 0.5);
    border: 1px solid #a18cd1;
}

QPushButton#toolButton:pressed {
    background: rgba(194, 182, 243, 0.7);
}

/* 发送按钮 */
QPushButton#sendButton {
    background: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,
                stop:0 #b8a4e6, stop:1 #a18cd1);
    color: white;
    border: none;
    border-radius: 20px;
    padding: 12px 30px;
    font: 700 12pt &quot;微软雅黑&quot;;
    min-width: 100px;
}

QPushButton#sendButton:hover {
    background: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,
                stop:0 #a18cd1, stop:1 #9179c4);
}

QPushButton#sendButton:pressed {
    background: qlineargradient(spread:pad,x1:0,y1:0,x2:1,y2:0,
                stop:0 #9179c4, stop:1 #8066b7);
}

QPushButton#sendButton:disabled {
    background: #d0d0d0;
    color: #888888;
}

/* 在线状态指示器 */
QLabel#statusIndicator {
    background: #4CAF50;
    border-radius: 6px;
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
}

QLabel#statusLabel {
    color: #6c5b7b;
    font: 10pt &quot;微软雅黑&quot;;
    background: transparent;
}

/* 统计信息 */
QLabel#statsLabel {
    color: #8b78c4;
    font: 9pt &quot;微软雅黑&quot;;
    background: transparent;
}

/* 滚动条样式 */
QScrollBar:vertical {
    background: rgba(214, 201, 247, 0.3);
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(161, 140, 209, 0.6);
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #a18cd1;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

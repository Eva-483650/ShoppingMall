   <string notr="true">
/* 默认浅色主题 */
QWidget#ShoppingManager {
    background: qlineargradient(spread:pad,x1:1,y1:0,x2:0,y2:1,
                stop:0 #e8e6fb, stop:0.6 #d6c9f7, stop:1 #b8a4e6);
    font-family:&quot;微软雅黑&quot;;
}

/* 顶部标题栏样式 */
QWidget#titleWidget {
    background: qlineargradient(spread:pad,x1:1,y1:0,x2:0,y2:0,
                stop:0 rgba(131, 96, 195, 0.9),
                stop:1 rgba(46, 191, 145, 0.9));
    border-radius: 15px;
    margin: 0px;
}

QLabel#titleLabel {
    background: transparent;
    color: white;
    font: 700 24pt &quot;微软雅黑&quot;;
    letter-spacing: 2px;
    border: none;
    padding: 5px 15px;
}

QLabel#adminLabel {
    background: transparent;
    color: rgba(255, 255, 255, 200);
    font: 12pt &quot;微软雅黑&quot;;
    border: none;
    padding: 5px 15px;
}

QLabel#themeLabel {
    background: transparent;
    color: rgba(255, 255, 255, 180);
    font: 10pt &quot;微软雅黑&quot;;
    border: none;
}

/* 主题选择下拉框 */
QComboBox {
    background: rgba(255, 255, 255, 0.9);
    border: 2px solid rgba(161, 140, 209, 0.6);
    border-radius: 8px;
    padding: 8px 12px;
    font: 11pt &quot;微软雅黑&quot;;
    color: #5a4c74;
    min-height: 20px;
}

QComboBox:hover {
    border: 2px solid #a18cd1;
    background: white;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
}

QComboBox::down-arrow {
    image: none;
    border: none;
    width: 12px;
    height: 8px;
    background: #a18cd1;
    margin: 0px 6px;
}

QComboBox QAbstractItemView {
    background: white;
    border: 1px solid #d6c9f7;
    border-radius: 8px;
    selection-background-color: #e8e6fb;
    font: 11pt &quot;微软雅黑&quot;;
    color: #5a4c74;
    padding: 4px;
}

/* 主题切换按钮 */
QPushButton#themeToggleBtn {
    background: rgba(255, 255, 255, 0.2);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 20px;
    padding: 8px 16px;
    font: 11pt &quot;微软雅黑&quot;;
    color: white;
    min-width: 80px;
}

QPushButton#themeToggleBtn:hover {
    background: rgba(255, 255, 255, 0.3);
    border: 2px solid rgba(255, 255, 255, 0.5);
}

QPushButton#themeToggleBtn:pressed {
    background: rgba(255, 255, 255, 0.1);
}

/* PageStack 透明，防止叠加底部灰层 */
QStackedWidget {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}

/* 侧边导航样式 */
QWidget#SideNav {
    background: transparent;
    border: none;
}

/* 黑夜模式样式 */
QWidget#ShoppingManager[darkMode=&quot;true&quot;] {
    background: qlineargradient(spread:pad,x1:1,y1:0,x2:0,y2:1,
                stop:0 #2c2c2c, stop:0.6 #1e1e1e, stop:1 #0f0f0f);
}

QWidget#titleWidget[darkMode=&quot;true&quot;] {
    background: qlineargradient(spread:pad,x1:1,y1:0,x2:0,y2:0,
                stop:0 rgba(45, 45, 45, 0.95),
                stop:1 rgba(25, 25, 25, 0.95));
}

QComboBox[darkMode=&quot;true&quot;] {
    background: rgba(60, 60, 60, 0.9);
    border: 2px solid rgba(100, 100, 100, 0.6);
    color: #e0e0e0;
}

QComboBox[darkMode=&quot;true&quot;]:hover {
    border: 2px solid #606060;
    background: rgba(70, 70, 70, 0.9);
}

QComboBox[darkMode=&quot;true&quot;]::down-arrow {
    background: #808080;
}

QComboBox[darkMode=&quot;true&quot;] QAbstractItemView {
    background: #3c3c3c;
    border: 1px solid #606060;
    selection-background-color: #505050;
    color: #e0e0e0;
}

QPushButton#themeToggleBtn[darkMode=&quot;true&quot;] {
    background: rgba(80, 80, 80, 0.8);
    border: 2px solid rgba(120, 120, 120, 0.6);
    color: #e0e0e0;
}

QPushButton#themeToggleBtn[darkMode=&quot;true&quot;]:hover {
    background: rgba(100, 100, 100, 0.8);
    border: 2px solid rgba(140, 140, 140, 0.8);
}

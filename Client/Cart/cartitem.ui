      <string notr="true">
QRadioButton {
    background: transparent;
    color: rgb(110, 100, 130);
    font: 600 12pt &quot;Microsoft YaHei&quot;;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 2px solid rgba(189, 170, 233, 80);
    background: rgba(255, 255, 255, 200);
}

QRadioButton::indicator:checked {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1,
                stop:0 rgba(189, 170, 233, 255),
                stop:0.5 rgba(201, 182, 243, 255),
                stop:1 rgba(213, 194, 253, 255));
    border: 2px solid rgba(189, 170, 233, 120);
}

QRadioButton::indicator:hover {
    border: 2px solid rgba(189, 170, 233, 120);
    background: rgba(240, 235, 250, 200);
}
      </string>
